# ============================================================
# 最简本地启动步骤（复制为 .env 后按需修改）：
#   0. node/npx 经 nvm 安装（v24），不在默认 PATH，先执行：
#      source ~/.nvm/nvm.sh
#   1. 后端：cd backend && python -m venv .venv && source .venv/bin/activate
#      pip install -r requirements.txt
#      cd backend 目录下需有 .env（SECRET_KEY 必填，config 无默认值）
#      uvicorn app.main:app --port 8000
#   2. pdf-service（可选）：source ~/.nvm/nvm.sh && cd pdf-service
#      npm install && npx puppeteer browsers install chrome
#      node server.js
#   3. OPENAI_API_KEY 可选：LLM 有兜底逻辑，无 key 时相关 AI 功能降级
#
# Docker 部署（推荐）：
#   cp .env.example .env && 修改 SECRET_KEY / OPENAI_API_KEY
#   docker compose up -d --build
#   访问 http://localhost:8082
#   注：Docker 模式下 DATABASE_URL / CORS / 上传与模型目录由
#       docker-compose.yml 注入，无需在 .env 重复设置
# ============================================================

# Backend Configuration
DATABASE_URL=sqlite:///./career_copilot.db

# 安全密钥 - 必填，config 无默认值（缺少时启动即崩）
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(32))"
# 或使用: openssl rand -base64 32
SECRET_KEY=your-production-secret-key-here

# Docker 部署专用（docker compose 读取）
# PostgreSQL 密码（db 服务与 backend 连接串共用，默认 postgres）
POSTGRES_PASSWORD=postgres
# pdf-service 地址（可选；部署了 pdf-service 容器时改为 http://pdf-service:3002）
PDF_SERVICE_URL=http://localhost:3002

# LLM（可选，LLM 有兜底；无 key 时 AI 功能降级）
OPENAI_API_KEY=sk-your-openai-api-key
ANTHROPIC_API_KEY=sk-your-anthropic-api-key
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# pdf-service（Node PDF 导出服务，可选）
# 服务监听端口：server.js 读取环境变量 PORT（默认 3002，避开 frontend 3001）
PORT=3002
# backend 调用 pdf-service 的地址（backend PDF 导出首选链路，失败自动降级 Markdown）
PDF_SERVICE_URL=http://localhost:3002
PDF_SERVICE_TIMEOUT=60
# 允许跨域的前端来源，逗号分隔（默认 http://localhost:3000,http://localhost:3001,http://localhost:3002）
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=AI Career Co-pilot