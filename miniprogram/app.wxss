/* 简历指南 / 履历资料夹。One paper surface, quiet lists, native controls. */
page{background:#f7f5f0;color:#292824;font-family:-apple-system,"PingFang SC","Microsoft YaHei",sans-serif;font-size:15px;line-height:1.65}
.wrap{box-sizing:border-box;padding:36rpx 40rpx calc(48rpx + env(safe-area-inset-bottom))}
.title,.sheet-name{font-family:"Songti SC","STSong","SimSun",serif;font-weight:600;letter-spacing:1rpx}
.title{font-size:28px;line-height:1.4;margin:0 0 24rpx;word-break:break-all}.page-head{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin-bottom:14rpx;min-height:88rpx}.page-head .title{flex:1;min-width:0;margin:0}.header-mark{width:58rpx;height:70rpx;flex-shrink:0}
.page-intro{font-size:14px;line-height:1.8;color:#706c65;margin:0 0 42rpx}.heading{font-size:17px;font-weight:600;line-height:1.55;word-break:break-all}.heading.small{font-size:16px}.sub,.intro{font-size:14px;color:#706c65;line-height:1.8;margin:12rpx 0 24rpx;word-break:break-all}.caption,.badge{font-size:13px;line-height:1.75;color:#746d63;margin-top:12rpx}.label{font-size:14px;color:#625e57;margin:30rpx 0 12rpx}.section-heading{font-size:16px;font-weight:600;margin-bottom:20rpx}
.card,.start-panel{margin:34rpx 0;padding:0;background:transparent}.card-head,.card-foot,.section-head{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.file-info{flex:1;min-width:0}.card-head .heading{flex:1;min-width:0}.card-head .sub{margin:8rpx 0 0}.divider{height:1rpx;background:#dedbd4;margin:28rpx 0}
.pill{display:inline-block;flex-shrink:0;font-size:13px;font-weight:400;line-height:1.65;color:#77716a;padding:5rpx 0;background:transparent}.pill:before{content:'·';margin-right:8rpx;font-weight:700}.pill.green{color:#53644b}.pill.amber{color:#8b622a}.pill.blue{color:#713746}.accent{color:#713746;font-size:14px}.tags{display:flex;flex-wrap:wrap;gap:10rpx 22rpx}.tag{font-size:13px;color:#625e57;padding:2rpx 0;background:transparent}.tag:after{content:' /';margin-left:8rpx;color:#b3ada2}.tag:last-child:after{content:''}
.resume-sheet{box-sizing:border-box;position:relative;background:#fffefa;border:1rpx solid #dedbd4;padding:34rpx 34rpx 30rpx;margin:12rpx 6rpx 30rpx 0;min-height:410rpx;box-shadow:7rpx 7rpx 0 -1rpx #f0ede6,7rpx 7rpx 0 0 #dedbd4}
.sheet-tab{position:absolute;right:36rpx;top:-1rpx;width:20rpx;height:34rpx;background:#713746}.sheet-top{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding-right:38rpx;margin-bottom:30rpx}.sheet-label{font-size:12px;color:#746d63;letter-spacing:1rpx}.sheet-name{font-size:29px;line-height:1.45;margin-bottom:6rpx;word-break:break-all}.sheet-role{font-size:14px;color:#706c65;line-height:1.8}.sheet-rule{height:1rpx;background:#dfdbd2;margin:28rpx 0 24rpx}.sheet-company{font-size:15px;line-height:1.7;margin-top:10rpx;word-break:break-all}.sheet-skills{margin-top:12rpx;font-size:13px;line-height:1.8;color:#706c65;word-break:break-all}.sheet-meta{margin-top:28rpx;font-size:13px;color:#746d63}.sheet-meta text{padding:0 14rpx}.empty-sheet{text-align:center;padding:44rpx 28rpx 34rpx;min-height:430rpx}.empty-document{width:76rpx;height:94rpx;margin:0 0 24rpx}.empty-sheet .heading{font-size:18px}.empty-sheet .sub{font-size:14px;margin:12rpx 0 24rpx}.line-break{display:block}.sheet-format{font-size:13px;color:#746d63}.document-state{padding:16rpx 0 24rpx}.document-state .spinner{margin-bottom:24rpx}.next-task{display:flex;align-items:center;justify-content:space-between;gap:24rpx;padding:32rpx 0;margin-top:36rpx;border-top:1rpx solid #d8d3c9;border-bottom:1rpx solid #d8d3c9}.next-task .sub{font-size:13px;margin:6rpx 0 0}.inline-count{font-family:serif;font-size:18px;color:#746d63;padding-left:16rpx;font-weight:400}.row-arrow{flex-shrink:0;font-size:22px;line-height:1;color:#746d63}
.wrap button:not([size=mini]){box-sizing:border-box;width:100%;min-height:44px;padding:22rpx 24rpx;margin:26rpx 0 0;background:#292824;color:#fffefa;border:1rpx solid #292824;border-radius:6rpx;font-size:15px;line-height:1.65;font-weight:500}.wrap button:after{border:0}.wrap button:active{opacity:.8}.wrap button[disabled]{background:#e8e5df;color:#979188;border-color:#e8e5df;opacity:1}.wrap button.secondary{background:transparent;color:#514a40;border-color:#c8c0b4}.wrap button.danger{background:transparent;color:#934238;border-color:#dbc6bc;font-size:14px}.wrap button.text-button{background:transparent;border:0;color:#713746;text-align:left;padding:22rpx 0;margin-top:4rpx;font-size:14px;font-weight:400}.wrap button[disabled].text-button{color:#979188}.wrap button.compact{width:auto;flex-shrink:0;margin:0;padding:20rpx 14rpx}.wrap button.main-action{display:flex;align-items:center;justify-content:space-between;margin-top:28rpx;padding:22rpx 30rpx}.main-action text{font-size:18px;font-weight:400}.wrap button.header-action{width:auto;margin:0;padding:20rpx 0 20rpx 24rpx;font-size:14px;flex-shrink:0}
input,textarea{box-sizing:border-box;width:100%;margin:10rpx 0 18rpx;padding:22rpx 24rpx;background:#fffefa;border:1rpx solid #d9d3c8;border-radius:4rpx;color:#292824;font-size:15px}input{height:96rpx;min-height:44px;line-height:48rpx}textarea{min-height:220rpx;line-height:1.9}.form-section{border-top:1rpx solid #d8d3c9;padding-top:30rpx;margin-top:36rpx}.form-section .section-heading{color:#713746}.form-section textarea{min-height:104rpx}.form-section .label{margin-top:22rpx}.record-tools{padding-bottom:24rpx;margin-bottom:24rpx;border-bottom:1rpx solid #d8d3c9}.record-tools button.danger{text-align:left;min-height:44px;padding-left:0;background:transparent;border:0;margin-top:8rpx}
.search-field{display:flex;align-items:center;gap:18rpx;border-bottom:1rpx solid #bfb7aa;padding:6rpx 0 10rpx;margin:8rpx 0 36rpx}.search-field image{width:32rpx;height:32rpx;flex-shrink:0}.search-field input{flex:1;min-width:0;background:transparent;border:0;margin:0;padding:18rpx 0;border-radius:0;font-size:14px}.list-count{font-size:13px;color:#746d63;margin:0 0 12rpx}.job-card{padding:30rpx 0;border-bottom:1rpx solid #d8d3c9;margin:0;background:transparent}.job-card .heading{font-size:17px}.job-company{font-size:14px;color:#706c65;margin-top:8rpx}.job-card .card-foot{margin-top:22rpx}.job-progress{display:flex;flex-wrap:wrap;gap:4rpx 22rpx;font-size:13px;color:#746d63;line-height:1.8}.status-line{display:flex;align-items:center;justify-content:space-between;gap:24rpx;padding:24rpx 0;margin:22rpx 0;border-top:1rpx solid #d8d3c9;border-bottom:1rpx solid #d8d3c9;font-size:14px;color:#625e57}.start-panel{padding:30rpx 0}.start-panel .empty-document{margin-bottom:26rpx}
.notice,.insight{padding:6rpx 0 6rpx 24rpx;border-left:3rpx solid #b8afa0;margin:26rpx 0;font-size:14px;line-height:1.85;background:transparent}.notice.green,.insight.green{border-color:#89987b;color:#53644b}.notice.amber,.insight.amber{border-color:#b9a078;color:#896228}.notice .sub{color:inherit;margin:0 0 18rpx}.insight .label{color:inherit;font-weight:600;margin:0 0 12rpx}.insight .tag{color:inherit}.suggestion{font-size:14px;margin:16rpx 0;line-height:1.9}.error{background:#f5eae3;border-left:3rpx solid #934238;color:#934238;padding:24rpx;margin:26rpx 0;font-size:14px;line-height:1.8;word-break:break-all}.error button.text-button{color:#934238}.empty{padding:40rpx 0;color:#706c65;font-size:14px}.loading-card{display:flex;align-items:center;gap:20rpx;padding:24rpx 0;color:#706c65;font-size:14px}.spinner{display:inline-block;flex-shrink:0;width:32rpx;height:32rpx;box-sizing:border-box;border:3rpx solid #ded7cb;border-top-color:#713746;border-radius:50%;animation:spin 1s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}
.raw{white-space:pre-wrap;line-height:1.95;font-size:15px;word-break:break-all}.source-panel{display:block;background:#fffefa;border:1rpx solid #dedbd4;padding:26rpx;max-height:480rpx;overflow:auto}.editor-caption{display:flex;align-items:center;justify-content:space-between;gap:20rpx;font-size:15px;font-weight:600;margin:32rpx 0 14rpx}.editor-caption text{font-size:12px;color:#746d63;font-weight:400}.editor{height:780rpx;padding:30rpx;font-size:15px;line-height:1.95;background:#fffefa;border:1rpx solid #dedbd4;border-radius:2rpx}.resume-context{font-size:14px;color:#706c65;margin:10rpx 0 22rpx;line-height:1.8}.file-row{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:20rpx 0;border-bottom:1rpx solid #d8d3c9;font-size:14px}.file-row button.text-button{width:auto;flex-shrink:0;margin:0;padding:20rpx}checkbox-group label{display:flex;align-items:center;min-height:44px;font-size:14px}checkbox{flex-shrink:0;transform:scale(.85);transform-origin:left center}.sheet-backdrop{position:fixed;top:0;bottom:0;left:0;right:0;z-index:99;background:#29282466;display:flex;align-items:flex-end}.export-sheet{box-sizing:border-box;width:100%;max-height:90vh;overflow:auto;background:#f7f5f0;border-radius:16rpx 16rpx 0 0;padding:32rpx 40rpx calc(36rpx + env(safe-area-inset-bottom))}.export-preview{height:400rpx;box-sizing:border-box;background:#fffefa;border:1rpx solid #dedbd4;padding:24rpx}
.login-page{padding-top:64rpx}.login-brand{display:flex;align-items:center;gap:20rpx;margin-bottom:72rpx}.login-brand .brand-icon{width:64rpx;height:80rpx}.brand-name{font-family:"Songti SC","STSong","SimSun",serif;font-size:20px;font-weight:600;letter-spacing:2rpx}.login-page .title{font-size:28px;margin-bottom:16rpx}.login-page .intro{margin-bottom:44rpx}.account-form{border-top:1rpx solid #d8d3c9;margin-top:20rpx;padding-top:30rpx}.account-form .heading{font-size:16px}.wrap.login-page button.text-button{text-align:center}.login-note{font-size:12px;color:#746d63;margin-top:20rpx}
.settings-section{margin:42rpx 0 34rpx}.section-head .caption{margin:0}.model-name{font-size:14px;color:#706c65;margin:12rpx 0 0}.quota-row{display:flex;align-items:center;justify-content:space-between;gap:24rpx;font-size:13px;color:#706c65;padding:24rpx 0;margin:16rpx 0;border-bottom:1rpx solid #d8d3c9}.quota-count{font-size:16px;color:#713746;font-weight:600}.wrap .key-actions button.text-button{font-size:13px;color:#746d63}.wrap button.disclosure-row{display:flex;align-items:center;justify-content:space-between;gap:20rpx;border-top:1rpx solid #d8d3c9;padding:26rpx 0;color:#514a40;margin-top:14rpx}.model-help,.privacy-note{font-size:13px;line-height:1.85;color:#706c65;padding:12rpx 0 28rpx}.model-help view+view,.privacy-note view+view{margin-top:16rpx}.account-options{border-top:1rpx solid #d8d3c9;margin-top:28rpx}.wrap .account-options button.account-row{display:flex;align-items:center;justify-content:space-between;gap:24rpx;margin:0;padding:28rpx 0;background:transparent;color:#514a40;border:0;border-bottom:1rpx solid #d8d3c9;border-radius:0;font-size:14px;text-align:left;font-weight:400}.wrap .account-options button.account-row.danger{color:#934238}.account-header{margin-bottom:36rpx}
