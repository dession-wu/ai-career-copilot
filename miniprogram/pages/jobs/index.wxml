<view wx:if="{{authenticated}}" class="wrap jobs-page">
 <view class="page-head"><view class="title">{{showForm?'添加岗位':'目标岗位'}}</view><button wx:if="{{ready && !showForm}}" class="text-button header-action" bindtap="toggleForm" disabled="{{busy}}">＋ 添加</button></view>
 <view wx:if="{{!busy && !ready}}" class="start-panel"><image src="/assets/document.png" class="empty-document"/><view class="heading">先准备好你的经历</view><view class="sub">核对简历档案后，即可添加目标岗位。</view><button data-page="vault" bindtap="go">去核对经历</button></view>
 <view wx:if="{{ready}}">
  <view wx:if="{{!showForm}}"><view class="page-intro">逐个了解，认真准备。</view><view wx:if="{{jobs.length}}" class="search-field"><image src="/assets/search.png"/><input aria-label="搜索岗位" placeholder="搜索公司或岗位" data-key="query" value="{{query}}" bindinput="input"/></view><view class="list-count">{{query?'找到 '+filtered.length+' 个岗位':'共 '+jobs.length+' 个目标岗位'}}</view>
   <view wx:for="{{filtered}}" wx:key="id" class="job-card" data-page="detail" data-id="{{item.id}}" bindtap="go" role="button"><view class="card-head"><view class="heading">{{item.job_title}}</view><text class="pill">{{item.statusLabel}}</text></view><view class="job-company">{{item.company_name}}</view><view class="card-foot"><view class="job-progress"><text>{{item.analysisLabel}}</text><text>{{item.resumeLabel}}</text></view><text class="row-arrow">↗</text></view></view>
   <view wx:if="{{query && !filtered.length}}" class="empty">没有找到相关岗位，换个关键词试试。</view>
  </view>
  <view wx:if="{{showForm}}"><view class="page-intro">粘贴职位要求，对照经历分析匹配。</view><view class="label">公司</view><input aria-label="公司" placeholder="公司名称" data-key="company_name" value="{{company_name}}" bindinput="input" maxlength="255" disabled="{{busy}}"/><view class="label">岗位名称</view><input aria-label="岗位名称" placeholder="你想申请的职位" data-key="job_title" value="{{job_title}}" bindinput="input" maxlength="255" disabled="{{busy}}"/><view class="label">职位描述</view><textarea aria-label="职位描述" placeholder="粘贴岗位职责和要求" data-key="jd_text" value="{{jd_text}}" bindinput="input" maxlength="-1" auto-height disabled="{{busy}}"/><button bindtap="saveJob" disabled="{{busy || !company_name || !job_title || !jd_text}}" loading="{{busy}}">保存岗位</button><button wx:if="{{jobs.length}}" class="text-button" bindtap="toggleForm" disabled="{{busy}}">取消</button></view>
 </view><view wx:if="{{busy}}" class="sub">处理中…</view><view wx:if="{{error}}" class="error">{{error}}<button class="text-button" bindtap="reload">重试</button></view>
</view>
