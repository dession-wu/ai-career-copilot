<view wx:if="{{authenticated}}" class="wrap"><view class="page-head"><view class="title">经历档案</view><text wx:if="{{vault}}" class="pill {{editing || !vault.structured_data._confirmed?'amber':'green'}}">{{editing || !vault.structured_data._confirmed?'待核对':'已确认'}}</text></view><view wx:if="{{pending}}" class="loading-card"><view class="spinner"/>正在解析，完成后可编辑。</view><button wx:if="{{!vault}}" bindtap="choose" disabled="{{busy || pending}}">{{vault?'重新上传':'上传简历'}}</button><view wx:if="{{!vault}}" class="empty">支持 PDF / DOCX，最大 10 MB</view><view wx:if="{{vault}}"><view wx:if="{{vault.structured_data._confirmed && !editing}}" class="card success-card"><view class="heading">经历已确认</view><view class="sub">下一步，添加你想申请的岗位。</view><button data-page="jobs" bindtap="go">选择目标岗位</button><button class="text-button" bindtap="editVault" disabled="{{busy || pending}}">修改经历</button></view><button class="text-button" bindtap="toggleRaw">{{showRaw?'收起原文':'查看简历原文'}}</button><view wx:if="{{showRaw}}" class="card"><text class="raw" selectable>{{vault.raw_content || '暂无原文'}}</text></view><view wx:if="{{editing || !vault.structured_data._confirmed}}" class="card"><view class="heading">核对经历</view><view class="sub">确认信息准确后保存。</view><view wx:for="{{groups}}" wx:key="title" wx:for-item="group" class="form-section"><view class="section-heading">{{group.title}}</view><view wx:for="{{group.fields}}" wx:key="path"><view class="label">{{item.shortLabel}}</view><textarea auto-height maxlength="-1" aria-label="{{item.label}}" value="{{item.value}}" data-path="{{item.path}}" bindinput="field" disabled="{{busy || pending}}"/></view></view><button class="text-button" bindtap="toggleRecords">{{showRecords?'收起增删选项':'增删经历与技能'}} <text>{{showRecords?'−':'＋'}}</text></button><view wx:if="{{showRecords}}" class="record-tools"><button class="secondary" data-kind="experiences" bindtap="addRecord" disabled="{{busy || pending}}">＋ 添加工作经历</button><button class="secondary" data-kind="skills" bindtap="addRecord" disabled="{{busy || pending}}">＋ 添加技能</button><button class="secondary" data-kind="education" bindtap="addRecord" disabled="{{busy || pending}}">＋ 添加教育经历</button><view wx:for="{{vault.structured_data.experiences}}" wx:key="index"><view class="label">工作经历 {{index + 1}} · {{item.company}}</view><view wx:for="{{item.projects}}" wx:for-item="project" wx:for-index="projectIndex" wx:key="index"><button class="danger" data-parent="{{index}}" data-index="{{projectIndex}}" bindtap="removeProject" disabled="{{busy || pending}}">移除项目 {{project.name}}</button></view><button class="secondary" data-index="{{index}}" bindtap="addProject" disabled="{{busy || pending}}">添加项目</button><button class="danger" data-kind="experiences" data-index="{{index}}" bindtap="removeEntry" disabled="{{busy || pending}}">移除此段经历</button></view><view wx:for="{{vault.structured_data.skills}}" wx:key="index"><button class="danger" data-kind="skills" data-index="{{index}}" bindtap="removeEntry" disabled="{{busy || pending}}">移除技能 {{item.name}}</button></view><view wx:for="{{vault.structured_data.education}}" wx:key="index"><button class="danger" data-kind="education" data-index="{{index}}" bindtap="removeEntry" disabled="{{busy || pending}}">移除教育 {{item.school}}</button></view></view><button bindtap="saveVault" disabled="{{busy || pending}}">确认并保存</button></view></view><view wx:if="{{vault}}"><button class="text-button" bindtap="toggleMore">{{showMore?'收起管理选项':'管理简历'}}</button><view wx:if="{{showMore}}"><button class="secondary" bindtap="choose" disabled="{{busy || pending}}">重新上传</button><button class="danger" bindtap="removeVault" disabled="{{busy || pending}}">删除经历档案</button></view></view><view wx:if="{{busy}}" class="sub">正在处理，请稍候…</view><view wx:if="{{error}}" class="error">{{error}}<button class="secondary" bindtap="reload" disabled="{{busy}}">重试加载</button></view><view wx:if="{{message}}" class="card badge">{{message}}</view></view>

