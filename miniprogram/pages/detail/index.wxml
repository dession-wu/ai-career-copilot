<view wx:if="{{authenticated}}" class="wrap"><view wx:if="{{job}}">
 <view class="page-head"><view class="title">{{job.job_title}}</view><text wx:if="{{hasAnalysis && analysis.score !== null}}" class="pill blue">匹配 {{analysis.score}} / 100</text></view><view class="sub">{{job.company_name}}</view>
 <view wx:if="{{!editing}}">
 <picker range="{{labels}}" value="{{statusIndex}}" bindchange="status" disabled="{{busy}}"><view class="status-line"><text>投递进度</text><text>{{labels[statusIndex]}}　⌄</text></view></picker>
 <view wx:if="{{!ready}}" class="start-panel"><view class="sub">简历经历尚未确认。</view><button data-page="vault" bindtap="go">去确认经历</button></view>
 <view wx:if="{{ready}}"><button wx:if="{{!hasAnalysis}}" bindtap="analyze" disabled="{{busy}}">分析匹配</button><button wx:if="{{hasAnalysis}}" data-page="resume" data-id="{{job.id}}" bindtap="go" disabled="{{busy}}">准备简历</button><view wx:if="{{hasAnalysis && analysis}}" class="card"><view class="section-heading">岗位匹配参考</view><view class="insight green"><view class="label">已有技能线索</view><view class="tags"><text wx:for="{{analysis.matched}}" wx:key="*this" class="tag">{{item}}</text><text wx:if="{{!analysis.matched.length}}">暂无明确匹配线索</text></view></view><view class="insight amber"><view class="label">待补充证据</view><view wx:for="{{analysis.missing}}" wx:key="*this">{{item}}</view><view wx:if="{{!analysis.missing.length}}">暂无额外技能线索，请仍核对岗位要求。</view></view><view wx:if="{{analysis.suggestions.length}}"><view class="label">下一步建议</view><view wx:for="{{analysis.suggestions}}" wx:key="*this" class="suggestion">{{index+1}}. {{item}}</view></view><view class="caption">匹配参考不代表录用概率。</view></view><button wx:if="{{hasAnalysis}}" class="text-button" bindtap="analyze" disabled="{{busy}}">重新分析</button></view>
 <button class="text-button" bindtap="showDescription">{{showDescription?'收起职位描述':'查看职位描述'}}</button><text wx:if="{{showDescription}}" class="raw" selectable>{{job.jd_text}}</text><button class="text-button" bindtap="editJob" disabled="{{busy}}">编辑岗位</button>
 </view><view wx:if="{{editing}}"><view class="label">公司</view><input aria-label="公司" data-key="company_name" value="{{company_name}}" bindinput="input" disabled="{{busy}}"/><view class="label">岗位</view><input aria-label="岗位" data-key="job_title" value="{{job_title}}" bindinput="input" disabled="{{busy}}"/><view class="label">职位描述</view><textarea aria-label="职位描述" data-key="jd_text" value="{{jd_text}}" bindinput="input" maxlength="-1" auto-height disabled="{{busy}}"/><button bindtap="saveJob" disabled="{{busy || !company_name || !job_title || !jd_text}}">保存修改</button><button class="text-button" bindtap="cancelEdit" disabled="{{busy}}">取消编辑</button><button class="danger" bindtap="remove" disabled="{{busy}}">删除岗位</button></view>
 </view><view wx:if="{{busy}}" class="sub">处理中…</view><view wx:if="{{error}}" class="error">{{error}}<button class="text-button" bindtap="reload">重试</button></view><view wx:if="{{message}}" class="sub">{{message}}</view></view>
