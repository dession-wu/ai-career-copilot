{
  "name": "local-ai-career-copilot",
  "networks": {
    "default": {
      "name": "ai_career_copilot_default",
      "ipam": {}
    }
  },
  "services": {
    "backend": {
      "restart": "unless-stopped",
      "command": null,
      "entrypoint": null,
      "environment": {
        "ANTHROPIC_API_KEY": "${ANTHROPIC_API_KEY}",
        "CORS_ORIGINS_JSON": "[\"https://career.podnotes.cloud\",\"http://localhost:8082\"]",
        "DATABASE_URL": "${DATABASE_URL}",
        "EASYOCR_MODEL_DIR": "/app/models/easyocr",
        "LLM_MODEL": "gpt-4o",
        "LLM_PROVIDER": "openai",
        "OPENAI_API_KEY": "${OPENAI_API_KEY}",
        "PADDLEX_MODEL_DIR": "/app/models/paddlex",
        "PDF_SERVICE_URL": "http://localhost:3002",
        "SECRET_KEY": "${SECRET_KEY}",
        "UPLOAD_DIR": "/app/backend/uploads"
      },
      "networks": {
        "default": null
      },
      "build": {
        "context": "../..",
        "dockerfile": "backend.Dockerfile.local"
      },
      "depends_on": {
        "db": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "volumes": [
        {
          "type": "volume",
          "source": "uploads_data",
          "target": "/app/backend/uploads",
          "volume": {}
        },
        {
          "type": "volume",
          "source": "models_data",
          "target": "/app/models",
          "volume": {}
        },
        "./runtime/private:/app/private"
      ]
    },
    "db": {
      "restart": "unless-stopped",
      "command": null,
      "entrypoint": null,
      "environment": {
        "POSTGRES_DB": "career_copilot",
        "POSTGRES_PASSWORD": "${POSTGRES_PASSWORD}",
        "POSTGRES_USER": "postgres"
      },
      "image": "postgres:15",
      "networks": {
        "default": null
      },
      "volumes": [
        {
          "type": "volume",
          "source": "pgdata",
          "target": "/var/lib/postgresql/data",
          "volume": {}
        }
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready -U postgres -d career_copilot"
        ],
        "timeout": "5s",
        "interval": "10s",
        "retries": 5
      }
    },
    "frontend": {
      "restart": "unless-stopped",
      "command": null,
      "entrypoint": null,
      "networks": {
        "default": null
      },
      "build": {
        "context": "../..",
        "dockerfile": "frontend.Dockerfile.local",
        "args": {
          "NEXT_PUBLIC_API_URL": ""
        }
      },
      "depends_on": {
        "backend": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "wget -q --spider http://127.0.0.1/ || exit 1"
        ],
        "timeout": "5s",
        "interval": "15s",
        "retries": 3,
        "start_period": "10s"
      },
      "ports": [
        {
          "mode": "ingress",
          "target": 80,
          "published": "8082",
          "protocol": "tcp",
          "host_ip": "127.0.0.1"
        }
      ]
    },
    "pdf-service": {
      "restart": "unless-stopped",
      "command": null,
      "entrypoint": null,
      "environment": {
        "PORT": "3002",
        "PUPPETEER_EXECUTABLE_PATH": "/usr/bin/chromium"
      },
      "networks": {
        "default": null
      },
      "build": {
        "context": "../../pdf-service",
        "dockerfile": "pdf-service.Dockerfile.local"
      }
    }
  },
  "volumes": {
    "models_data": {
      "name": "ai_career_copilot_models_data"
    },
    "pgdata": {
      "name": "ai_career_copilot_pgdata"
    },
    "uploads_data": {
      "name": "ai_career_copilot_uploads_data"
    }
  }
}
