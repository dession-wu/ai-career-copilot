{
  "name": "ai-career-copilot",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "app",
    "shared"
  ],
  "scripts": {
    "dev:web": "cd frontend && npm run dev",
    "dev:app": "cd app && npm run dev",
    "dev:backend": "cd backend && python -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload",
    "build:web": "cd frontend && npm run build",
    "build:app": "cd app && npm run build",
    "build:all": "npm run build:web && npm run build:app",
    "test:web": "cd frontend && npm run test",
    "test:app": "cd app && npm run test",
    "test:all": "npm run test:web && npm run test:app",
    "lint:web": "cd frontend && npm run lint",
    "lint:app": "cd app && npm run lint"
  },
  "dependencies": {
    "next": "16.1.7"
  }
}
