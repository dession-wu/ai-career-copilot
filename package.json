{
  "name": "ai-career-copilot",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "shared"
  ],
  "scripts": {
    "dev:web": "cd frontend && npm run dev",
    "dev:backend": "cd backend && python -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload",
    "build:web": "cd frontend && npm run build",
    "build:all": "npm run build:web",
    "test:web": "cd frontend && npm run test",
    "test:all": "npm run test:web && npm run test:mini",
    "lint:web": "cd frontend && npm run lint",
    "test:mini": "node --test miniprogram/tests/*.test.js",
    "check:mini:release": "node miniprogram/scripts/preflight.js"
  },
  "dependencies": {
    "next": "16.4.5"
  }
}
